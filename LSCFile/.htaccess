# Cache policy: HTML pages are cached by the client for at most 48 hours,
# then revalidated. Static assets keep a longer cache.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=172800, public, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 2 days"
</IfModule>
